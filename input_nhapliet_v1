/**
 * KSK auto — dán 1 lần vào Console → hiện panel góc phải.
 * Hoặc bookmark: javascript:(function(){var s=document.createElement('script');s.src='...';})()
 */
(function () {
  if (!window.jQuery) {
    alert("Cần jQuery trên trang HIS.");
    return;
  }
  // reload nếu đã inject lần trước
  if (window.KSK_AUTO && window.KSK_AUTO._destroy) {
    try {
      window.KSK_AUTO._destroy();
    } catch (e) {}
  }

  var $ = window.jQuery;
  
  // CONFIG — có thể thay đổi qua menu
  var CFG = {
    // Thông tin bác sĩ & nội dung
    BS: "1327430",
    LY_DO: "Kiểm tra khám sàng lọc",
    TUAN_HOAN: "Chưa phát hiện bệnh lý",
    
    // Chế độ xử lý
    API_MODE: false,  // LUÔN TẮT - chỉ dùng UI mode cho ổn định
    
    // Tốc độ xử lý (ms)
    QUIET: 150,        // chờ UI ổn định (giảm từ 250 → 150)
    POLL: 50,          // kiểm tra trạng thái (giảm từ 80 → 50)
    
    // Timeout (ms)
    KYSO_WAIT_MS: 30000,      // chờ xác thực SmartCA (giảm từ 45s → 30s)
    KYSO_GRID_WAIT_MS: 4000,  // chờ nút ký xuất hiện (giảm từ 6s → 4s)
    EMPTY_WAIT_MS: 3000,      // list trống chờ refresh (giảm từ 4s → 3s)
    
    // Sinh hiệu random (nam)
    NAM_HEIGHT_MIN: 160,
    NAM_HEIGHT_MAX: 175,
    NAM_HEIGHT_60_MIN: 155,
    NAM_HEIGHT_60_MAX: 170,
    
    // Sinh hiệu random (nữ)
    NU_HEIGHT_MIN: 150,
    NU_HEIGHT_MAX: 165,
    NU_HEIGHT_60_MIN: 145,
    NU_HEIGHT_60_MAX: 160,
    
    // BMI & sinh hiệu khác
    BMI_MIN: 20.0,
    BMI_MAX: 24.0,
    MACH_MIN: 65,
    MACH_MAX: 90,
    MACH_60_MIN: 60,
    MACH_60_MAX: 85,
    NHIPTHO_MIN: 16,
    NHIPTHO_MAX: 20,
    NHIETDO: 37,
    HUYETAP_MIN: 100,
    HUYETAP_MAX: 128,
    HUYETAP_60_MIN: 120,
    HUYETAP_60_MAX: 140,
  };
  
  // lâm sàng đủ 18 — bỏ Sản phụ khoa
  var LS_MUC = [
    { nd: "tt32_mau2tuanhoan", bs: "tt32_mau2bacsituanhoan" },
    { nd: "tt32_mau2noitiet", bs: "tt32_mau2bacsinoitiet" },
    { nd: "tt32_mau2hohap", bs: "tt32_mau2bacsihohap" },
    { nd: "tt32_mau2tieuhoa", bs: "tt32_mau2bacsitieuhoa" },
    { nd: "tt32_mau2tietnieu", bs: "tt32_mau2bacsitietnieu" },
    { nd: "tt32_mau2coxuongkhop", bs: "tt32_mau2bacsixuongkhop" },
    { nd: "tt32_mau2thankinh", bs: "tt32_mau2bacsithankinh" },
    { nd: "tt32_mau2tamthan", bs: "tt32_mau2bacsitamthan" },
    { nd: "tt32_mau2ngoaikhoa", bs: "tt32_mau2bacsingoaikhoa" },
    { nd: "tt32_mau2ngkdalieu", bs: "tt32_mau2bacsingoaikhoa" }, // da liễu chung BS ngoại
    { nd: "tt32_mau2benhvemat", bs: "tt32_mau2bacsimat" },
    { nd: "tt32_mau2benhvetai", bs: "tt32_mau2bacsitaimuihong" },
    { nd: "tt32_mau2benhverang", bs: "tt32_mau2bacsiranghammat" },
  ];
  var STOP = true;
  var RUNNING = false;
  var CONTINUOUS = false;
  var REFRESH_REQUESTED = false;
  var DONE = new Set(); // grid row id đã xử lý
  var BN_DONE = new Set(); // MA_BENH_NHAN đã xử lý (không lặp khi refresh)
  var KYSO_DONE = {}; // mayte -> { CKS_NGUOI_KET_LUAN:1, CKS_BENH_VIEN:1 }
  var STEP = 0;
  var LOGS = [];
  var ENABLE_KYSO = true;
  var ENABLE_AUTO_REFRESH = true;

  function bnMayte() {
    return ($("#mayte").val() || "").trim();
  }

  function mayteOfRow(id) {
    try {
      var r = $("#list1").jqGrid("getRowData", id);
      return r && r.MA_BENH_NHAN ? String(r.MA_BENH_NHAN).trim() : "";
    } catch (e) {
      return "";
    }
  }

  function kysoDaKy(mayte, role) {
    return !!(mayte && KYSO_DONE[mayte] && KYSO_DONE[mayte][role]);
  }

  function kysoDu2(mayte) {
    return (
      kysoDaKy(mayte, "CKS_NGUOI_KET_LUAN") &&
      kysoDaKy(mayte, "CKS_BENH_VIEN")
    );
  }

  function markKyso(mayte, role) {
    if (!mayte) return;
    if (!KYSO_DONE[mayte]) KYSO_DONE[mayte] = {};
    KYSO_DONE[mayte][role] = 1;
  }

  function kySoEnabled() {
    var $toggle = $("#ksk_auto_kyso");
    if ($toggle.length) ENABLE_KYSO = $toggle.is(":checked");
    return ENABLE_KYSO;
  }

  function autoRefreshEnabled() {
    var $toggle = $("#ksk_auto_refresh");
    if ($toggle.length) ENABLE_AUTO_REFRESH = $toggle.is(":checked");
    return ENABLE_AUTO_REFRESH;
  }

  function sleep(ms) {
    return new Promise(function (r) {
      setTimeout(r, ms);
    });
  }

  function rnd(a, b) {
    return Math.floor(Math.random() * (b - a + 1)) + a;
  }
  
  function rndFloat(a, b) {
    return Math.random() * (b - a) + a;
  }

  function setStatus(s) {
    var el = document.getElementById("ksk_auto_status");
    if (el) el.textContent = s;
  }

  function pushLog(line) {
    LOGS.push(line);
    if (LOGS.length > 40) LOGS.shift();
    var box = document.getElementById("ksk_auto_log");
    if (box) {
      box.textContent = LOGS.slice(-12).join("\n");
      box.scrollTop = box.scrollHeight;
    }
  }

  function log(msg) {
    STEP++;
    var t = new Date().toLocaleTimeString("vi-VN");
    var line = "#" + STEP + " " + t + " " + msg;
    console.log("[KSK_AUTO] " + line);
    pushLog(line);
    setStatus(msg);
  }

  function warn(msg) {
    STEP++;
    var line = "#" + STEP + " ⚠ " + msg;
    console.warn("[KSK_AUTO] " + line);
    pushLog(line);
    setStatus(msg);
  }

  function isConfirmBtnText(t) {
    t = String(t || "").trim();
    return /^(OK|Đồng ý|Có|Tiếp tục|Xác nhận|Confirm|Yes)$/i.test(t) ||
      /^xác\s*nhận$/i.test(t);
  }

  async function clickDongY(maxMs) {
    maxMs = maxMs || 2500;
    var t0 = Date.now();
    var n = 0;
    while (Date.now() - t0 < maxMs) {
      var hit = false;
      $(
        ".ui-dialog-buttonset button, button.ui-button, #popup_ok, .jAlert button, .smartca-ad-alert button, .swal2-confirm, button.confirm"
      ).each(function () {
        if (!$(this).is(":visible")) return;
        var t = ($(this).text() || $(this).val() || "").trim();
        if (isConfirmBtnText(t)) {
          $(this).trigger("click");
          hit = true;
          n++;
        }
      });
      if ($("#popup_ok").is(":visible")) {
        $("#popup_ok").trigger("click");
        hit = true;
        n++;
      }
      if (!hit) break;
      await sleep(CFG.POLL);
    }
    if (n) log("bấm Xác nhận/Đồng ý ×" + n);
    return n;
  }

  // Chờ #smartca-alert → bấm Xác nhận (poll nhanh)
  async function confirmAfterSign(label, maxMs) {
    maxMs = maxMs || CFG.KYSO_WAIT_MS;
    log("⏳ chờ #smartca-alert «" + label + "»…");
    var t0 = Date.now();
    while (Date.now() - t0 < maxMs) {
      if (STOP) return false;
      setStatus(
        "Xác nhận «" + label + "»… " + Math.round((Date.now() - t0) / 1000) + "s"
      );
      var $alert = $("#smartca-alert:visible");
      if ($alert.length) {
        var $ok = $alert.find(".smartca-alert-button-confirm:visible").first();
        if ($ok.length) {
          var txt = ($alert.find(".smartca-alert-content").text() || "").trim();
          $ok[0].click();
          log("✓ Xác nhận «" + label + "»: " + txt.slice(0, 60));
          await sleep(200);
          return true;
        }
      }
      await clickDongY(150);
      await sleep(CFG.POLL);
    }
    warn("timeout xác nhận «" + label + "»");
    return false;
  }

  function haDuoiTheoTren(tren) {
    // 100 → /60 | <110 → /70 | >=120 → /80 | 110–119 → /70
    if (tren <= 100) return 60;
    if (tren < 110) return 70;
    if (tren >= 120) return 80;
    return 70;
  }

  function vitals(age, isNam) {
    var h = isNam 
      ? rnd(age >= 60 ? CFG.NAM_HEIGHT_60_MIN : CFG.NAM_HEIGHT_MIN, 
            age >= 60 ? CFG.NAM_HEIGHT_60_MAX : CFG.NAM_HEIGHT_MAX)
      : rnd(age >= 60 ? CFG.NU_HEIGHT_60_MIN : CFG.NU_HEIGHT_MIN,
            age >= 60 ? CFG.NU_HEIGHT_60_MAX : CFG.NU_HEIGHT_MAX);
    var bmi = rndFloat(CFG.BMI_MIN, CFG.BMI_MAX);
    var w = Math.round((bmi * h * h) / 10000);
    var tren = age >= 60 
      ? rnd(CFG.HUYETAP_60_MIN, CFG.HUYETAP_60_MAX)
      : rnd(CFG.HUYETAP_MIN, CFG.HUYETAP_MAX);
    return {
      mach: age >= 60 
        ? rnd(CFG.MACH_60_MIN, CFG.MACH_60_MAX)
        : rnd(CFG.MACH_MIN, CFG.MACH_MAX),
      nhiptho: rnd(CFG.NHIPTHO_MIN, CFG.NHIPTHO_MAX),
      chieucao: h,
      cannang: w,
      nhietdo: CFG.NHIETDO,
      huyetaptren: tren,
      huyetapduoi: haDuoiTheoTren(tren),
    };
  }

  function doiTuongTheoTuoi(age) {
    if (age > 60) return "1";
    if (age < 22) return "11";
    if (age >= 22 && age <= 60) return "13";
    return "16";
  }

  function setVal(id, v) {
    var $el = $("#" + id);
    if (!$el.length) return;
    $el.val(v).trigger("change").trigger("input");
  }

  function setChosen(id, v) {
    var $el = $("#" + id);
    if (!$el.length) return false;
    var el = $el[0];
    if ($el.find('option[value="' + v + '"]').length) {
      $el.val(v);
    } else {
      // fallback: chọn option chứa mã BS
      var hit = false;
      $el.find("option").each(function () {
        if (String(this.value) === String(v) || String(this.value).indexOf(v) >= 0) {
          this.selected = true;
          hit = true;
          return false;
        }
      });
      if (!hit) {
        warn("không có option BS=" + v + " trong #" + id);
        return false;
      }
    }
    try {
      el.dispatchEvent(new Event("change", { bubbles: true }));
    } catch (e) {}
    $el.trigger("chosen:updated").trigger("change");
    return String($el.val()) === String(v) || String($el.val()).indexOf(v) >= 0;
  }

  function fillSinhHieu(v) {
    log(
      "sinh hiệu M" +
        v.mach +
        " NT" +
        v.nhiptho +
        " " +
        v.chieucao +
        "cm " +
        v.cannang +
        "kg HA" +
        v.huyetaptren +
        "/" +
        v.huyetapduoi
    );
    setVal("mach", v.mach);
    setVal("nhiptho", v.nhiptho);
    setVal("chieucao", v.chieucao);
    setVal("cannang", v.cannang);
    setVal("nhietdo", v.nhietdo);
    setVal("huyetaptren", v.huyetaptren);
    setVal("huyetapduoi", v.huyetapduoi);
  }

  // bỏ dấu + lower để bắt Long Châu / LONG CHÂU / long chau…
  function stripVn(s) {
    return String(s || "")
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase();
  }

  function hasLongChau(s) {
    return /long\s*chau/.test(stripVn(s));
  }

  function patchDiaChi() {
    var $d = $("#tt32_mau2kskdiachi");
    var cur = ($d.val() || "").trim();
    if (!hasLongChau(cur)) {
      $d.val((cur ? cur + ", " : "") + "P. Long Châu").trigger("change");
      log("chèn P. Long Châu");
    }
  }

  // 12 số OK; 11 số + bắt đầu ≠ 0 → thêm 0 đầu; còn lại → null (Hủy)
  function fixCmnd(raw) {
    var s = String(raw || "").replace(/\s+/g, "").trim();
    if (/^\d{12}$/.test(s)) return s;
    if (/^\d{11}$/.test(s) && s.charAt(0) !== "0") return "0" + s;
    return null;
  }

  function applyCmndOrFail() {
    var $el = $("#tt32_mau2ksksocmnd");
    if (!$el.length) $el = $("#socmnd");
    var raw = ($el.val() || "").trim();
    var fixed = fixCmnd(raw);
    if (!fixed) {
      warn("CCCD/CMND không hợp lệ («" + raw + "» len=" + raw.length + ") → Hủy");
      return false;
    }
    if (fixed !== raw) {
      log("CCCD pad 0 đầu: " + raw + " → " + fixed);
      $el.val(fixed).trigger("change");
    } else {
      log("CCCD OK: " + fixed);
    }
    return true;
  }

  function closeChosenDrops() {
    try {
      $(".chosen-container")
        .removeClass("chosen-with-drop chosen-container-active");
      $(".chosen-drop").hide();
    } catch (e) {}
  }

  function fillLamSangAll() {
    log("→ lâm sàng ALL (trừ Sản phụ khoa) + chọn BS");
    for (var i = 0; i < LS_MUC.length; i++) {
      var m = LS_MUC[i];
      setVal(m.nd, CFG.TUAN_HOAN);
      if (m.bs) setChosen(m.bs, CFG.BS);
    }
    if ($("#tt32_mau2bacsidalieu").length) setChosen("tt32_mau2bacsidalieu", CFG.BS);
    setVal("tt32_mau2sanphukhoa", "");
    setChosen("tt32_mau2bacsiphukhoa", "0");
    try {
      $("#tt32_mau2ksk-tab3 select").trigger("chosen:updated");
    } catch (e) {}
    closeChosenDrops();
  }

  // Thiếu nội dung / bác sĩ (0 hoặc rỗng) → list id
  function lamSangMissing() {
    var miss = [];
    for (var i = 0; i < LS_MUC.length; i++) {
      var m = LS_MUC[i];
      var nd = ($("#" + m.nd).val() || "").trim();
      if (!nd) miss.push(m.nd);
      if (m.bs) {
        var bv = String($("#" + m.bs).val() || "");
        if (!bv || bv === "0") miss.push(m.bs);
      }
    }
    return miss;
  }

  async function fillLamSangVerified() {
    var t0 = Date.now();
    while (Date.now() - t0 < 4000) {
      if ($("#tt32_mau2tuanhoan").length) break;
      await sleep(100);
    }
    if (!$("#tt32_mau2tuanhoan").length) {
      warn("không thấy #tt32_mau2tuanhoan — tab lâm sàng chưa sẵn");
      return false;
    }
    for (var attempt = 1; attempt <= 4; attempt++) {
      fillLamSangAll();
      await sleep(180);
      var miss = lamSangMissing();
      if (!miss.length) {
        closeChosenDrops();
        log(
          "✓ lâm sàng đủ — tuần hoàn=«" +
            ($("#tt32_mau2tuanhoan").val() || "").slice(0, 40) +
            "» BS=" +
            $("#tt32_mau2bacsituanhoan").val()
        );
        return true;
      }
      warn(
        "lâm sàng thiếu lần " +
          attempt +
          ": " +
          miss.slice(0, 6).join(", ") +
          (miss.length > 6 ? "…" : "")
      );
      // load AJAX có thể vừa ghi đè — chờ rồi điền lại
      await sleep(350);
      await waitIdle(2000, 150);
    }
    return false;
  }

  async function waitLuuKskOk(maxMs) {
    maxMs = maxMs || 15000;
    log("⏳ chờ Lưu KSK thành công…");
    var t0 = Date.now();
    while (Date.now() - t0 < maxMs) {
      if (STOP) return false;
      var txt = stripVn(
        (
          $("#popup_message:visible").text() ||
          $(".jAlert:visible").text() ||
          $("#popup_container:visible").text() ||
          ""
        ).trim()
      );
      if (/da\s*cap\s*nhat|luu\s*thanh\s*cong|thanh\s*cong/.test(txt)) {
        await clickDongY(1500);
        log("✓ Lưu KSK OK");
        return true;
      }
      // lỗi quy trình — đừng ký
      if (/vui\s*long\s*thuc\s*hien\s*kham|khong\s*the|that\s*bai/.test(txt)) {
        warn("Lưu KSK báo lỗi: " + txt.slice(0, 80));
        await clickDongY(1500);
        return false;
      }
      await clickDongY(200);
      await sleep(200);
    }
    warn("timeout chờ «Đã cập nhật» sau Lưu");
    return false;
  }

  // Chỉ overlay thật — KHÔNG dùng $.active (HIS hay giữ AJAX → kẹt mãi)
  function isLoadingUi() {
    if ($(".blockUI").filter(":visible").length) return true;
    if ($("#load_list1").is(":visible")) return true;
    var busy = false;
    $(".loading").each(function () {
      if ($(this).is(":visible") && $(this).css("display") !== "none") busy = true;
    });
    return busy;
  }

  async function waitIdle(maxMs, quietMs, label) {
    maxMs = maxMs || 10000;
    quietMs = quietMs == null ? CFG.QUIET : quietMs;
    if (isLoadingUi()) log("đang nạp…" + (label ? " " + label : ""));
    var t0 = Date.now();
    var quietFrom = null;
    while (Date.now() - t0 < maxMs) {
      if (STOP && label !== "force") return false;
      if (isLoadingUi()) quietFrom = null;
      else {
        if (quietFrom == null) quietFrom = Date.now();
        if (Date.now() - quietFrom >= quietMs) return true;
      }
      await sleep(CFG.POLL);
    }
    return true; // hết giờ → làm tiếp, không kẹt
  }

  async function guardReady(label) {
    if (!isLoadingUi()) return true;
    log("chờ hết nạp: " + label);
    await waitIdle(8000, CFG.QUIET, label);
    return true;
  }

  async function waitBnReady(ms) {
    log("chờ load BN…");
    var t0 = Date.now();
    while (Date.now() - t0 < (ms || 15000)) {
      if (STOP) return false;
      var hoten = ($("#hoten").val() || "").trim();
      var tuoi = ($("#tuoi").val() || "").trim();
      var mayte = ($("#mayte").val() || "").trim();
      if (hoten && tuoi !== "" && mayte && !isLoadingUi()) {
        await sleep(CFG.QUIET);
        if (
          ($("#hoten").val() || "").trim() === hoten &&
          ($("#tuoi").val() || "").trim() === tuoi
        ) {
          log("BN OK: " + hoten + " tuổi " + tuoi);
          return true;
        }
      }
      await sleep(CFG.POLL);
    }
    warn("BN chưa load đủ");
    return false;
  }

  async function waitKskLoad(ms) {
    log("chờ phiếu KSK load xong…");
    var t0 = Date.now();
    var sawHoten = false;
    while (Date.now() - t0 < (ms || 12000)) {
      if (STOP) return false;
      if (($("#tt32_mau2kskhoten").val() || "").trim()) {
        if (!sawHoten) {
          sawHoten = true;
          log("đã có họ tên — chờ AJAX load xong (tránh bị ghi đè)…");
        }
        // đợi overlay + ổn định thêm: load async còn clear tuần hoàn/BS
        await waitIdle(5000, Math.max(CFG.QUIET, 300));
        await sleep(300);
        // tab lâm sàng / select BS đã có trong DOM
        if ($("#tt32_mau2tuanhoan").length && $("#tt32_mau2bacsituanhoan").length) {
          log("✓ phiếu KSK sẵn sàng");
          return true;
        }
      }
      await sleep(CFG.POLL);
    }
    return sawHoten; // có hoten nhưng thiếu field — vẫn thử
  }

  function rowIds() {
    try {
      return $("#list1").jqGrid("getDataIDs") || [];
    } catch (e) {
      return [];
    }
  }

  function pendingIds() {
    return rowIds().filter(function (id) {
      if (DONE.has(String(id))) return false;
      var m = mayteOfRow(id);
      if (m && BN_DONE.has(m)) {
        DONE.add(String(id)); // đồng bộ row id mới sau refresh
        return false;
      }
      return true;
    });
  }

  function pickRandomId() {
    var ids = pendingIds();
    if (!ids.length) return null;
    var id = ids[rnd(0, ids.length - 1)];
    var ret = $("#list1").jqGrid("getRowData", id);
    var ten = (ret && (ret.TEN_BENH_NHAN || ret.TEN_BENH_NHAN_HT)) || "?";
    log("🎲 chọn " + id + " (" + ids.length + " còn) " + ten);
    updateCount();
    return id;
  }

  function updateCount() {
    var el = document.getElementById("ksk_auto_count");
    if (el)
      el.textContent =
        "List: " +
        rowIds().length +
        " | Xong: " +
        DONE.size +
        " | Còn: " +
        pendingIds().length +
        (RUNNING ? " | 🔄" : "");
  }

  function getDvtt() {
    if (typeof dvtt !== "undefined" && dvtt) return String(dvtt);
    if (typeof Sess_DVTT !== "undefined" && Sess_DVTT) return String(Sess_DVTT);
    return "86098";
  }

  function getUserId() {
    if (typeof Sess_UserID !== "undefined" && Sess_UserID) return String(Sess_UserID);
    return BS;
  }

  async function refreshList() {
    log("⟳ làm mới danh sách BN");
    try {
      $("#lammoi").click();
    } catch (e) {
