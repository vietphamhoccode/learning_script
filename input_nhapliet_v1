  // float → Khác → mỗi BN tối đa 1× kết luận + 1× BV
  async function kySoViaFloat() {
    if (!kySoEnabled()) {
      log("bỏ qua ký số");
      return;
    }
    if (!dangNhapLieu()) {
      warn("chưa đang khám — bỏ ký float");
      return;
    }

    var mayte = bnMayte();
    if (kysoDu2(mayte)) {
      log("BN " + mayte + " đã ký đủ 2 chữ ký — bỏ qua");
      return;
