  // API Mode: Gọi backend trực tiếp thay vì thao tác UI
  async function fillKskViaApi(age, v) {
    if (!CFG.API_MODE) return null; // không dùng API mode
    
    log("⚡ API MODE: lưu KSK qua API");
    var mayte = bnMayte();
    var hoten = ($("#hoten").val() || "").trim();
    var gioitinh = $("#gioitinh").val() === "true" ? "Nam" : "Nữ";
    var dt = doiTuongTheoTuoi(age);
    
    // Chuẩn bị payload
    var payload = {
      mabenhnhan: mayte,
      hoten: hoten,
      tuoi: age,
      gioitinh: gioitinh,
      doituong: dt,
      lydo: CFG.LY_DO,
      chieucao: v.chieucao,
      cannang: v.cannang,
      mach: v.mach,
      nhiptho: v.nhiptho,
      nhietdo: v.nhietdo,
      huyetaptren: v.huyetaptren,
      huyetapduoi: v.huyetapduoi,
      tuanhoan: CFG.TUAN_HOAN,
      bacsi: CFG.BS
    };
    
    try {
      // Gọi API lưu KSK (giả định endpoint - cần điều chỉnh theo HIS thực tế)
      log("→ POST API lưu KSK...");
      var response = await fetch("ksk_save_api", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      
      if (!response.ok) {
        warn("API lưu KSK lỗi: " + response.status);
        return false;
      }
      
      var result = await response.json();
      log("✓ API lưu KSK thành công: " + JSON.stringify(result).slice(0, 100));
      return true;
    } catch (e) {
      warn("API MODE lỗi: " + (e && e.message) + " — fallback sang UI mode");
      return null; // null = fallback sang UI mode
    }
  }

  async function fillKsk(age, v) {
    // Thử API mode trước
    if (CFG.API_MODE) {
      var apiResult = await fillKskViaApi(age, v);
      if (apiResult === true) {
        log("✓ API MODE hoàn tất — sẵn sàng ký");
        return true;
      }
      if (apiResult === false) {
        return false; // API fail hoàn toàn
      }
      // apiResult === null → fallback sang UI mode
      log("→ fallback sang UI mode");
    }
    
    // UI Mode (mặc định)
    await guardReady("KSK");
    log("→ mở KSK đủ 18");
    $("#khamsuckhoetheodoituongdu18").click();
    if (!(await waitKskLoad(12000))) {
      warn("KSK chưa load");
      return false;
    }
    if (!applyCmndOrFail()) return "bad_cmnd";

    // Tab thông tin hành chính — điền SAU khi AJAX load xong
    var dt = doiTuongTheoTuoi(age);
    log("điền KSK đối tượng=" + dt);
    setVal("tt32_mau2kskdoituong", dt);
    $("#tt32_mau2kskdoituong").trigger("change");
    await sleep(120);
    setVal("tt32_mau2ksklydo", CFG.LY_DO);
    patchDiaChi();
    setVal("tt32_mau2chieucao", v.chieucao);
    setVal("tt32_mau2cannang", v.cannang);
    setVal("tt32_mau2kskmach", v.mach);
    setVal("tt32_mau2kskhuyetapcao", v.huyetaptren);
    setVal("tt32_mau2kskhuyetapthap", v.huyetapduoi);
    try {
      if (typeof tt32_loadchiso_mau2 === "function") tt32_loadchiso_mau2();
    } catch (e) {}

    // Tab lâm sàng — chờ hiện rồi điền + verify
    log("→ tab Khám lâm sàng");
    $("#tt32_mau2ksk_tab3").click();
    await sleep(200);
    if (!(await fillLamSangVerified())) {
      warn("chưa điền xong lâm sàng/BS — KHÔNG Lưu, KHÔNG ký");
      return false;
    }

    // đối tượng có thể bị AJAX ghi đè — set lại trước Lưu
    if (String($("#tt32_mau2kskdoituong").val() || "") !== String(dt)) {
      setVal("tt32_mau2kskdoituong", dt);
      $("#tt32_mau2kskdoituong").trigger("change");
      await sleep(80);
    }
    if (!($("#tt32_mau2kskdoituong").val() || "").trim()) {
      warn("đối tượng trống — KHÔNG Lưu/ký");
      return false;
    }
