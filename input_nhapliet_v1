  // Dialog → ép chọn đúng role → verify → mới bấm KÝ SỐ
  // LUÔN RESET về option đầu trước khi chọn để tránh lỗi chọn sai
  async function pickRoleAndKy(roleVal, roleText) {
    var kind = await waitRoleDialog(8000);
    if (!kind) {
      warn("dialog chọn vai trò không mở");
      return false;
    }
    
    // Chờ option xuất hiện trong select
    var t0 = Date.now();
    while (Date.now() - t0 < 3000) {
      var $s =
        kind === "xml" ? $("#slb-vai-tro-sign-xml") : $("#slb-vai-tro-vnptca");
      if ($s.find('option[value="' + roleVal + '"]').length) break;
      if ($s.find("option").length >= 2) break;
      await sleep(80);
    }
    
    log("chọn vai trò: " + roleText + " (" + roleVal + ")");
    
    // Chọn lần 1
    var setOk =
      kind === "xml" ? selectVaiTroXml(roleVal) : selectVaiTroVnpt(roleVal);
    
    if (!setOk) {
      warn("chọn vai trò lần 1 thất bại");
      return false;
    }
    
    // Đợi UI update
    await sleep(100);
    
    // Chọn lần 2 để chắc chắn (tránh race condition)
    if (kind === "xml") selectVaiTroXml(roleVal);
    else selectVaiTroVnpt(roleVal);
    
    await sleep(100);
    
    // Verify lần cuối
    var cur =
      kind === "xml"
        ? ($("#slb-vai-tro-sign-xml").val() || "")
        : ($("#slb-vai-tro-vnptca").val() || "");
        
    if (String(cur) !== String(roleVal)) {
      warn("select sai sau 2 lần: got=" + cur + " want=" + roleVal + " — ép lần 3");
      if (kind === "xml") {
        selectVaiTroXml(roleVal);
        await sleep(80);
        cur = $("#slb-vai-tro-sign-xml").val() || "";
      } else {
        selectVaiTroVnpt(roleVal);
        await sleep(80);
        cur = $("#slb-vai-tro-vnptca").val() || "";
      }
      if (String(cur) !== String(roleVal)) {
        warn("KHÔNG THỂ chọn «" + roleText + "» sau 3 lần thử");
        return false;
      }
    }
    
    log("✓ đã chọn " + cur + " — bấm KÝ SỐ");
    await sleep(100);
    
    if (kind === "xml") {
      var $ky = $("#btn-ky-so-xml-ca");
      if (!$ky.length) {
        warn("không thấy #btn-ky-so-xml-ca");
        return false;
      }
      $ky[0].click();
    } else {
      $("#btn-ky-so-vnpt-ca")[0].click();
    }
    return true;
  }

