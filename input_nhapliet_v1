  // Ép chọn đúng option — .val() đôi khi không đổi nếu dialog vừa mở
  // QUAN TRỌNG: luôn chọn lại từ đầu, không tin vào giá trị hiện tại
  function selectVaiTroXml(roleVal) {
    var el = document.getElementById("slb-vai-tro-sign-xml");
    if (!el) {
      warn("không thấy #slb-vai-tro-sign-xml");
      return false;
    }
    var $sel = $(el);
    
    // RESET: bỏ chọn tất cả trước
    $sel.find("option").each(function () {
      this.selected = false;
    });
    
    var ok = false;
    // 1) đúng value
    $sel.find("option").each(function () {
      if (String(this.value) === String(roleVal)) {
        this.selected = true;
        ok = true;
        return false;
      }
    });
    // 2) fallback theo text
    if (!ok) {
      var want =
        roleVal === "CKS_BENH_VIEN"
          ? /chu\s*ky\s*benh\s*vien|benh\s*vien/
          : /nguoi\s*ket\s*luan|ket\s*luan/;
      $sel.find("option").each(function () {
        if (want.test(stripVn(this.textContent || ""))) {
          this.selected = true;
          roleVal = this.value;
          ok = true;
          return false;
        }
      });
    }
    
    // Force set giá trị nhiều lần
    el.value = roleVal;
    $sel.val(roleVal);
    
    // Trigger events
    try {
      el.dispatchEvent(new Event("change", { bubbles: true }));
      el.dispatchEvent(new Event("input", { bubbles: true }));
    } catch (e) {}
    $sel.trigger("change").trigger("chosen:updated");
    
    // Verify
    var got = el.value;
    var gotText = ($sel.find("option:selected").text() || "").trim();
    log("select vai trò → value=" + got + " text=" + gotText);
    
    if (String(got) !== String(roleVal)) {
      warn("RESET VAI TRÒ THẤT BẠI: got=" + got + " want=" + roleVal);
      return false;
    }
    return true;
  }

  function selectVaiTroVnpt(roleVal) {
    var $sel = $("#slb-vai-tro-vnptca");
    var matched = false;
    $sel.find("option").each(function () {
      var t = stripVn($(this).text() || "");
      if (roleVal === "CKS_NGUOI_KET_LUAN" && /ket\s*luan/.test(t)) {
        this.selected = true;
        matched = true;
        return false;
      }
      if (
        roleVal === "CKS_BENH_VIEN" &&
        (/benh\s*vien/.test(t) || /don\s*vi/.test(t) || /thu\s*truong/.test(t))
      ) {
        this.selected = true;
        matched = true;
        return false;
      }
    });
    if (!matched && $sel.find("option").length) {
      var opts = $sel.find("option");
      if (roleVal === "CKS_BENH_VIEN" && opts.length > 1)
        opts[opts.length - 1].selected = true;
      else if (opts.length) opts[0].selected = true;
    }
    $sel.trigger("change");
    return matched || !!$sel.val();
  }

