  // Lưu trên màn khám (danh sách BN) sau khi ký
  async function luuDanhSachBn() {
    log("→ Lưu danh sách BN (#luu)");
    await guardReady("Lưu DS");
    var $luu = $("#luu");
    if (!$luu.length) {
      warn("không thấy #luu");
      return false;
    }
    if ($luu.prop("disabled") || $luu.hasClass("button_disabled")) {
      warn("#luu đang disabled — bỏ qua");
      return false;
    }
    try {
      $luu[0].click();
    } catch (e) {
      $luu.click();
    }
    await clickDongY(2000);
    await waitIdle(5000, CFG.QUIET);
    await clickDongY(600);
    log("✓ đã Lưu danh sách BN");
    return true;
  }

  function dangNhapLieu() {
    var hasBn = !!($("#hoten").val() || "").trim();
    if (!hasBn) return false;
    var ttk = $('input[name=trangthaikham]:checked').val();
    if (ttk === "2") return true;
    if (
      typeof trangthaikham !== "undefined" &&
      (trangthaikham === "kham" || trangthaikham === "sua")
    )
      return true;
    if ($("#kham").prop("disabled")) return true;
    return false;
  }

  async function ensureExamOpen() {
    if (dangNhapLieu()) {
      log("đang nhập sẵn → không ấn Khám");
      return await waitBnReady(12000);
    }
    if ($("#kham").prop("disabled")) {
      warn("Khám disabled");
      return false;
    }
    await guardReady("Khám");
    log("→ ấn Khám");
    $("#kham").click();
    await sleep(150);
    await clickDongY(500);
    return await waitBnReady(15000);
  }

  async function safeHuy() {
    await waitIdle(4000, CFG.QUIET);
    if (!dangNhapLieu() && !($("#hoten").val() || "").trim()) return;
    
    // Lưu danh sách BN trước khi Hủy
    try {
      await luuDanhSachBn();
    } catch (e) {
      warn("Lưu DS trước Hủy lỗi: " + (e && e.message));
    }
    
    log("→ Hủy");
    $("#huy").click();
    await clickDongY(1000);
    await waitIdle(4000, CFG.QUIET);
  }

  function markBnDone(id) {
    DONE.add(String(id));
    var m = bnMayte() || mayteOfRow(id);
    if (m) BN_DONE.add(m);
    updateCount();
  }

  async function fillCurrentPatient(id) {
    if (STOP) return;
    var m0 = mayteOfRow(id);
    if (m0 && BN_DONE.has(m0)) {
      log("⏭ BN " + m0 + " đã xử lý — bỏ qua");
      DONE.add(String(id));
      updateCount();
      return;
    }
    log("===== BN " + id + (m0 ? " / " + m0 : "") + " =====");
    if (!(await ensureExamOpen())) return;

    var mayte = bnMayte() || m0;
    if (mayte && BN_DONE.has(mayte)) {
      log("⏭ BN " + mayte + " đã xử lý — bỏ qua");
      markBnDone(id);
      return;
    }

    var ageRaw = ($("#tuoi").val() || "").trim();
    if (ageRaw === "") {
      warn("thiếu tuổi");
      return;
    }
    var age = parseInt(ageRaw, 10);
    if (isNaN(age)) return;
    var isNam = $("#gioitinh").val() === "true";
    log((isNam ? "Nam" : "Nữ") + " " + age + " tuổi");
    if (age < 18) {
      warn("<18 bỏ");
      await safeHuy();
      markBnDone(id);
      return;
    }

    try {
      await openBhyt();
    } catch (e) {
      await clickDongY(500);
    }

    await guardReady("sinh hiệu");
    var v = vitals(age, isNam);
    fillSinhHieu(v);

    if (
      !$("#khamsuckhoetheodoituongdu18").is(":visible") ||
      $("#khamsuckhoetheodoituongdu18").prop("disabled")
    ) {
      warn("không có nút KSK đủ 18");
    } else {
      var kskRet = await fillKsk(age, v);
      if (kskRet === "bad_cmnd") {
        closeKskDialog();
        await safeHuy();
        markBnDone(id);
        return;
      }
      // BS+Lưu+Đồng ý+đóng bảng → ký → Hủy (Lưu DS tự động trước Hủy)
      if (kskRet) {
        if (kySoEnabled()) {
          try {
            await kySoViaFloat();
          } catch (e) {
            warn("ký float lỗi: " + (e && e.message));
            closeSmartCaModal();
          }
        } else {
          log("KSK đã lưu — tắt ký số");
        }
      }
    }

    await safeHuy();
    markBnDone(id);
    log("xong BN " + id + (mayte ? " / " + mayte : ""));
  }

  async function processRow(id) {
    if (STOP || DONE.has(String(id))) return;
    if (dangNhapLieu()) {
      var curId = $("#list1").jqGrid("getGridParam", "selrow");
      if (curId && String(curId) !== String(id)) await safeHuy();
      else if (curId && String(curId) === String(id)) {
        await fillCurrentPatient(id);
        return;
      }
    }
    await guardReady("chọn dòng");
    $("#list1").jqGrid("setSelection", id, true);
    await sleep(80);
    await waitIdle(4000, CFG.QUIET);
    await fillCurrentPatient(id);
  }

  async function start() {
    if (RUNNING) {
      warn("đang chạy rồi");
      return;
    }
    RUNNING = true;
    STOP = false;
    CONTINUOUS = true;
    REFRESH_REQUESTED = false;
    STEP = 0;
    DONE.clear(); // ponytail: giữ BN_DONE + KYSO_DONE qua Start lại trong phiên
    updateBtn();
    log("▶ START liên tục");
    updateCount();

    while (!STOP) {
      try {
        if (autoRefreshEnabled() || REFRESH_REQUESTED) {
          REFRESH_REQUESTED = false;
          await refreshList();
        }
        var ids = pendingIds();
        if (!ids.length) {
          log(
            (autoRefreshEnabled()
              ? "list trống — chờ "
              : "đã xử lý hết danh sách hiện tại — chờ ") +
              CFG.EMPTY_WAIT_MS / 1000 +
              "s rồi quét lại…"
          );
          updateCount();
          await sleep(CFG.EMPTY_WAIT_MS);
          continue;
        }
        var id = pickRandomId();
        if (!id) {
          await sleep(CFG.EMPTY_WAIT_MS);
          continue;
        }
        await processRow(id);
      } catch (e) {
        warn("lỗi: " + (e && e.message));
        console.error(e);
        try {
          await clickDongY(800);
          await safeHuy();
        } catch (e2) {}
      }
    }
    log("⏹ đã dừng — xử lý được " + DONE.size + " BN");
    RUNNING = false;
    STOP = true;
    CONTINUOUS = false;
    REFRESH_REQUESTED = false;
    updateBtn();
  }

  async function runOne() {
    if (RUNNING) {
      warn("đang chạy rồi");
      return;
    }
    RUNNING = true;
    STOP = false;
    CONTINUOUS = false;
    REFRESH_REQUESTED = false;
    STEP = 0;
    updateBtn();
    log("▶ 1 BN");
    try {
      if (dangNhapLieu()) {
        await fillCurrentPatient($("#list1").jqGrid("getGridParam", "selrow"));
      } else {
        var id = pickRandomId();
        if (!id) warn("hết BN / list trống");
        else await processRow(id);
      }
    } catch (e) {
      warn(String(e && e.message));
    }
    RUNNING = false;
    STOP = true;
    CONTINUOUS = false;
    REFRESH_REQUESTED = false;
    updateBtn();
    log("xong 1 BN");
  }

  function stop() {
    STOP = true;
    REFRESH_REQUESTED = false;
    log("⏹ STOP…");
    updateBtn();
  }

  function updateBtn() {
    var go = document.getElementById("ksk_auto_go");
    var one = document.getElementById("ksk_auto_one");
    var st = document.getElementById("ksk_auto_stop");
    var refresh = document.getElementById("ksk_auto_refresh_now");
    if (go) go.disabled = RUNNING;
    if (one) one.disabled = RUNNING;
    if (st) st.disabled = !RUNNING;
    if (refresh) refresh.disabled = !RUNNING || !CONTINUOUS;
  }

