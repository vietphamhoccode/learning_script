      await sleep(150);
      if (!(await goTabKhac(5000))) {
        closeSmartCaModal();
        return;
      }
      if (!(await waitKskSignBtn(Math.min(CFG.KYSO_GRID_WAIT_MS, 4000)))) {
        closeSmartCaModal();
        return;
      }
      await kyMotVaiTro("CKS_BENH_VIEN", "Chữ ký bệnh viện");
    } else {
      log("⏭ Chữ ký bệnh viện đã có — xong");
