  async function waitKskSignBtn(maxMs) {
    var totalWait = Math.min(maxMs || CFG.KYSO_GRID_WAIT_MS, 6000);
    var t0 = Date.now();
    var firstWait = Math.min(3000, totalWait);
    log("theo dõi tab Khác tìm nút XML_KSK… (3 giây)");

    async function waitUntil(deadline) {
      while (Date.now() < deadline) {
        if (STOP) return null;
        var $b = findKskSignBtn();
        if ($b.length && $b.is(":visible")) return $b;
        setStatus("Chờ nút ký KSK… " + Math.round((Date.now() - t0) / 1000) + "s");
        await sleep(Math.min(150, deadline - Date.now()));
      }
      return null;
    }

    var $signBtn = await waitUntil(t0 + firstWait);
    if ($signBtn && $signBtn.length) {
      log("✓ nút ký data-id=" + $signBtn.attr("data-id") + " row=" + $signBtn.attr("data-row-id"));
      return $signBtn;
    }
    if (STOP) return null;

    if (totalWait > firstWait) {
      var $reload = $("#reloads:visible").first();
      if ($reload.length) {
        $reload[0].click();
        log("chưa thấy nút ký sau 3 giây — đã bấm reloads, chờ thêm 3 giây");
      } else {
        warn("chưa thấy nút ký sau 3 giây và không thấy nút #reloads; vẫn chờ thêm");
      }
      $signBtn = await waitUntil(t0 + totalWait);
      if ($signBtn && $signBtn.length) {
        log("✓ nút ký xuất hiện sau reload data-id=" + $signBtn.attr("data-id") + " row=" + $signBtn.attr("data-row-id"));
        return $signBtn;
      }
    }
    warn("không thấy nút ký XML_KSK… — BỎ QUA");
    return null;
  }

