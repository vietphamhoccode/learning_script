    stop: stop,
    config: CFG,
    setSpeed: function (quietMs, pollMs) {
      if (quietMs != null) CFG.QUIET = Math.max(50, quietMs);
      if (pollMs != null) CFG.POLL = Math.max(30, pollMs);
      log("QUIET=" + CFG.QUIET + " POLL=" + CFG.POLL);
    },
    done: DONE,
    bnDone: BN_DONE,
    kysoDone: KYSO_DONE,
    _destroy: function () {
      stop();
      $("#ksk_auto_panel").remove();
      $("#ksk_auto_style").remove();
    },
  };
